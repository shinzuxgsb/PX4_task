<?xml version="1.0"?>
<package format="3">
  <name>p_to_p_px4</name>
  <version>0.1.0</version>
  <description>PX4 uXRCE-DDS offboard bridge for the point-to-point aircraft (DDS only).</description>
  <maintainer email="maintainer@example.com">yeyulun16-dot</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
